# ---------------------------------------------------------------------
# Supabase (Project Settings → API Keys)
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Publishable key (sb_publishable_...) o la anon key legacy.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) o la service_role key legacy. SOLO servidor.
SUPABASE_SECRET_KEY=

# URL pública de la app (links de pago, back_urls y webhook de Mercado Pago).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Mercado Pago (Tus integraciones → Credenciales). Para la demo: credenciales de prueba.
# ---------------------------------------------------------------------
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Clave secreta del webhook (Tus integraciones → Webhooks → Clave secreta).
MP_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# Vercel Cron: Vercel lo manda como "Authorization: Bearer <CRON_SECRET>".
# Generar con: openssl rand -hex 32
# ---------------------------------------------------------------------
CRON_SECRET=

# Datos del club que se muestran en mensajes y en la página de pago.
NEXT_PUBLIC_CLUB_NOMBRE="El Cardo Polo Club"
NEXT_PUBLIC_CLUB_WHATSAPP=5493489367123
